# StorageLens frontend configuration.
#
# Copy this file to .env and set the values for your build.
# .env is git-ignored — never commit it.
#
# Base URL of the StorageLens API Gateway (HTTP API, $default stage),
# without a trailing slash and WITHOUT the /documents path:
#   VITE_API_BASE_URL=https://abc123.execute-api.ap-south-1.amazonaws.com
#
# This is the ONLY value this build needs. Sign-in config (Cognito
# pool id, client id, hosted-UI domain) is fetched at runtime from
# the API's public GET /config route, so a fresh clone needs nothing
# beyond the deployed API URL.
#
# Leave VITE_API_BASE_URL unset to run the frontend against no
# backend — the app will show its empty/error states and all
# experiment pages still work from the bundled artifacts.
VITE_API_BASE_URL=